<Window x:Class="FOS.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOS"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#12121A">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#7C6CFF"
                                BorderThickness="1"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="28">
        <TextBlock x:Name="TitleText" Text="Pengaturan" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock x:Name="SubtitleText" Margin="0,8,0,24" Foreground="#A0A0B0" FontSize="13" TextWrapping="Wrap"
                   Text="Atur berapa persen FOS mengecilkan gambar dan dokumen Office."/>
        <TextBlock Text="Target penghematan" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        <UniformGrid Rows="1" Margin="-4,12,-4,8">
            <Button x:Name="LightButton" Style="{StaticResource PillButton}" Click="OnPresetClick"/>
            <Button x:Name="BalancedButton" Style="{StaticResource PillButton}" Click="OnPresetClick"/>
            <Button x:Name="StrongButton" Style="{StaticResource PillButton}" Click="OnPresetClick"/>
        </UniformGrid>
        <Slider x:Name="TargetSlider" TickFrequency="5" IsSnapToTickEnabled="True"
                Margin="0,12,0,0" ValueChanged="OnTargetChanged"/>
        <TextBlock x:Name="TargetText" Margin="0,10,0,0" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailText" Margin="0,4,0,0" Foreground="#A0A0B0" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Margin="0,12,0,0" Foreground="#A0A0B0" FontSize="12" TextWrapping="Wrap"
                   Text="Hasil bisa meleset. File yang sudah kecil, PNG, atau dokumen tanpa gambar sulit mencapai target, dan FOS akan memberi tahu kalau targetnya tidak tercapai."/>
        <Button x:Name="SaveButton" Content="Simpan" Style="{StaticResource PillButton}" Margin="0,28,0,0"
                Width="160" HorizontalAlignment="Right" Background="#7C6CFF" Click="OnSaveClick"/>
    </StackPanel>
</Window>